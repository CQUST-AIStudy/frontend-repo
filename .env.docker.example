# 前端 Docker Compose 环境变量示例
# 用法：copy .env.docker.example .env.docker，按实际部署修改后：
#   docker compose --env-file .env.docker up -d --build
#
# 默认值全部指向 host.docker.internal，即各后端服务暴露在宿主端口上的场景。
# 若各服务与前端处于同一 docker 网络，把 *_HOST 改为对应 service name。

# 前端对外端口（宿主:容器）
FRONTEND_HOST_PORT=8080

# Java 后端（/api 与 /rag 均经此代理，与 devServer 行为一致）
BACKEND_HOST=host.docker.internal
BACKEND_PORT=8081

# LeetCodeClaw
LEETCODE_CLAW_HOST=host.docker.internal
LEETCODE_CLAW_PORT=10170

# PTA 爬虫（spider-repo 或 PTA-Claw）
SPIDER_HOST=host.docker.internal
SPIDER_PORT=8100

# 推荐服务
RECOMMENDATION_HOST=host.docker.internal
RECOMMENDATION_PORT=8003

# 错题分析服务
ERROR_ANALYSIS_HOST=host.docker.internal
ERROR_ANALYSIS_PORT=8002

# 演示模式：设为 true 时登录免校验密码、返回演示用户，用于后端不可用时的纯前端演示。
# 注意：该变量在构建期注入，修改后必须带 --build 重新构建镜像才生效。
VUE_APP_DEMO_MODE=false
