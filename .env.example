# Copy this file to .env.local and fill local-only values there.
# .env.local is ignored by git and can contain your real backend address.

VUE_APP_API_BASE_URL=
VUE_APP_RAG_API_BASE_URL=/rag
VUE_APP_USE_MOCK_DATA=true
VUE_APP_DEMO_MODE=false

# vue-cli 开发服务器代理目标（未设置时使用本机默认端口）
DEV_BACKEND_TARGET=http://localhost:8081
DEV_RAG_TARGET=http://localhost:8081
DEV_LEETCODE_CLAW_TARGET=http://127.0.0.1:10170
DEV_SPIDER_TARGET=http://127.0.0.1:8100
DEV_RECOMMENDATION_TARGET=http://127.0.0.1:8003
DEV_ERROR_ANALYSIS_TARGET=http://127.0.0.1:8002
DEV_KNOWLEDGE_GRAPH_TARGET=http://127.0.0.1:10171

REMOTE_API_BASE_URL=http://your-backend-host:8000
REMOTE_RAG_API_BASE_URL=http://your-backend-host:8000/api/rag

# 知识图谱生产环境通过 nginx /knowledge-graph 反代到 Go 服务访问。
# 前端不配置数据库地址、账号或密码。
